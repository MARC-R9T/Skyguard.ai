# ============================================================
#  SkyGuard AI — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit your actual .env file to Git.
# ============================================================

# ------------------------------------------------------------
# OpenSky Network API Credentials
# Sign up free at: https://opensky-network.org/index.php?option=com_users&view=registration
# Authenticated users get higher API rate limits (10 req/10s vs 5 req/10s)
# ------------------------------------------------------------
SKYGUARD_OPENSKY_USERNAME=your_opensky_username_here
SKYGUARD_OPENSKY_PASSWORD=your_opensky_password_here

# ------------------------------------------------------------
# OpenSky API Tuning Parameters (optional, defaults shown)
# ------------------------------------------------------------
# How long (seconds) to cache a successful API response before re-fetching
SKYGUARD_OPENSKY_CACHE_SECONDS=30
# HTTP request timeout in seconds
SKYGUARD_OPENSKY_TIMEOUT_SECONDS=8
# How long to wait (seconds) after a failed request before retrying
SKYGUARD_OPENSKY_FAILURE_BACKOFF_SECONDS=120
# How long to wait (seconds) after a 429 rate-limit response
SKYGUARD_OPENSKY_RATE_LIMIT_BACKOFF_SECONDS=600

# ------------------------------------------------------------
# Weather API
# Get your free key at: https://www.weatherapi.com/signup.aspx
# ------------------------------------------------------------
SKYGUARD_WEATHER_API_URL=https://api.weatherapi.com/v1
SKYGUARD_WEATHER_API_KEY=your_weatherapi_key_here

# ------------------------------------------------------------
# AI Prediction Mode
# Options: "heuristic" | "ml" | "hybrid"
#   heuristic = Pure math-based linear extrapolation (no model needed)
#   ml        = LSTM model only (requires lstm_model.keras + scaler.pkl)
#   hybrid    = Try ML first, fall back to heuristic if confidence is low
# ------------------------------------------------------------
SKYGUARD_PREDICTION_MODE=hybrid

# ------------------------------------------------------------
# Backend API Concurrency
# Max number of concurrent streaming JSON responses served at once
# Increase on high-memory machines, decrease on constrained servers
# ------------------------------------------------------------
SKYGUARD_STREAM_CONCURRENCY=6

# ------------------------------------------------------------
# Gemini AI API Key (optional — for AI-powered briefing generation)
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# App URL (used for self-referential links in deployed environments)
# For local dev, leave as http://localhost:5173
# ------------------------------------------------------------
APP_URL=http://localhost:5173
