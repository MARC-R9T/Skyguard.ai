# ============================================================
#  SkyGuard AI — .gitignore
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env.local
ENV/
env.bak/
venv.bak/

# PyInstaller
*.spec

# Unit test / coverage reports
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# IPython / Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# pyenv
.python-version

# ------------------------------------------------------------
# Secrets & Environment Files
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.json

# ------------------------------------------------------------
# Data Files (large / sensitive — use Git LFS or external storage)
# ------------------------------------------------------------

# Large backend data files (>5 MB — GitHub limit is 100 MB)
backend/data/raw_adsb.csv
backend/data/final_merged.csv
backend/data/registry_cleaned.csv
backend/data/basic-ac-db*.json.gz

# ACAS data directory (contains large gzipped CSVs)
backend/data/acas/

# External delay propagation — large training datasets
external/delay_propagation/Delay_Propagation/data/*.parquet
external/delay_propagation/Delay_Propagation/data/full_processed.parquet
external/delay_propagation/Delay_Propagation/data/train.parquet
external/delay_propagation/Delay_Propagation/data/test.parquet
external/delay_propagation/Delay_Propagation/india_aviation_flights_2025.csv

# Keep these smaller files (needed for dev/demo)
# backend/data/adsb_cleaned.csv        (~2.5 MB) <- keep
# backend/data/cleaned_data.csv        (~64 KB)  <- keep
# backend/data/opensky_log.csv         (~586 KB) <- keep
# external/.../aviation_industry_demo_dataset.csv <- keep

# ------------------------------------------------------------
# ML Model Weights (use Git LFS or DVC for large models)
# ------------------------------------------------------------
backend/data/lstm_model.h5
backend/data/lstm_model.keras
backend/data/scaler.pkl
backend/data/scaler.save
external/delay_propagation/Delay_Propagation/models/*.json
external/delay_propagation/Delay_Propagation/models/*.keras
external/delay_propagation/Delay_Propagation/models/*.pkl

# ------------------------------------------------------------
# Node.js / Frontend
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnp
.pnp.js
.yarn/
dist/
.vite/

# TypeScript
*.tsbuildinfo

# ------------------------------------------------------------
# VS Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------
